# Agent Service
PORT=8001
NODE_ENV=development

# ─── LLM Provider ─────────────────────────────────────────────────────────────
# 切换 Provider：anthropic（默认）| doubao
LLM_PROVIDER=doubao

# Anthropic（LLM_PROVIDER=anthropic 时必填）
ANTHROPIC_API_KEY=

# 豆包·火山引擎（LLM_PROVIDER=doubao 时必填）
# API Key 在火山引擎控制台 → 方舟 → API Key 管理 中获取
DOUBAO_API_KEY=bd12d96d-4d30-4248-b265-6951395c0380
# BaseURL 默认为北京区，如有其他区域可自行修改
DOUBAO_BASE_URL=https://ark.cn-beijing.volces.com/api/v3

# ─── Model Governance（按节点模型配置）─────────────────────────────────────────
# 不配置时自动按 Provider 选择默认：
# - anthropic: fast=claude-haiku-4-5, smart=claude-sonnet-4-5
# - doubao:    fast=doubao-lite-32k, smart=doubao-pro-32k
MODEL_ORCHESTRATOR_CLASSIFY_INTENT=doubao-seed-2-0-lite-260428
MODEL_QA_GENERATE=doubao-seed-2-0-pro-260215
MODEL_VIDEO_GENERATE_STORYBOARD=doubao-seed-2-0-pro-260215
MODEL_VIDEO_GENERATE_SCRIPT=doubao-seed-2-0-code-preview-260215
MODEL_VIDEO_FIX_SCRIPT=doubao-seed-2-0-code-preview-260215
MODEL_LEARNING_RECORD_EXTRACT_KNOWLEDGE=doubao-seed-2-0-pro-260215
MODEL_LEARNING_RECORD_GENERATE_REPORT=doubao-seed-2-0-pro-260215
MODEL_TOOL_IMAGE_OCR=doubao-seed-2-0-pro-260215

# ─── 依赖服务 ──────────────────────────────────────────────────────────────────
# RAG Service (Python FastAPI)
RAG_SERVICE_URL=http://localhost:8000

# Backend Server (Go API)
SERVER_URL=http://localhost:3000
INTERNAL_TOKEN=your-internal-service-token
# Optional: gRPC internal endpoint（预留，当前默认走 HTTP internal API）
SERVER_GRPC_URL=localhost:50051

# Optional: Redis (短期记忆，不配置则降级为内存）
REDIS_URL=redis://:Wangzi1313%23@bj-crs-99gvtc6l.sql.tencentcdb.com:24735/0

# Optional: Manim 渲染服务
MANIM_SERVICE_URL=http://localhost:8002

# Optional: 对象存储上传服务
STORAGE_SERVICE_URL=http://localhost:8003

# Optional: LLM 调试日志（开启后在终端打印模型返回）
LLM_LOG_RESPONSES=true
LLM_LOG_MAX_CHARS=4000
LLM_LOG_STREAM_DELTAS=true

# ─── Node Governance (SLA / Timeout / Retry) ────────────────────────────────
# QA Node Policies
QA_NODE_OCR_TIMEOUT_MS=8000
QA_NODE_OCR_RETRY_MAX_ATTEMPTS=2
QA_NODE_OCR_RETRY_BACKOFF_MS=200
QA_NODE_RAG_TIMEOUT_MS=10000
QA_NODE_RAG_RETRY_MAX_ATTEMPTS=2
QA_NODE_RAG_RETRY_BACKOFF_MS=300
QA_NODE_GENERATE_TIMEOUT_MS=120000
QA_NODE_GENERATE_RETRY_MAX_ATTEMPTS=1
QA_NODE_GENERATE_RETRY_BACKOFF_MS=0

# Video Node Policies
VIDEO_NODE_CHECK_CACHE_TIMEOUT_MS=4000
VIDEO_NODE_GENERATE_STORYBOARD_TIMEOUT_MS=18000
VIDEO_NODE_GENERATE_SCRIPT_TIMEOUT_MS=30000
VIDEO_NODE_RENDER_MANIM_TIMEOUT_MS=60000
VIDEO_NODE_FIX_SCRIPT_TIMEOUT_MS=25000
VIDEO_NODE_UPLOAD_VIDEO_TIMEOUT_MS=15000
