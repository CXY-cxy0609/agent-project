# Agent Service
PORT=8001
NODE_ENV=development

# ─── LLM Provider ─────────────────────────────────────────────────────────────
# 切换 Provider：anthropic（默认）| doubao
LLM_PROVIDER=anthropic

# Anthropic（LLM_PROVIDER=anthropic 时必填）
ANTHROPIC_API_KEY=

# 豆包·火山引擎（LLM_PROVIDER=doubao 时必填）
# API Key 在火山引擎控制台 → 方舟 → API Key 管理 中获取
DOUBAO_API_KEY=
# BaseURL 默认为北京区，如有其他区域可自行修改
DOUBAO_BASE_URL=https://ark.cn-beijing.volces.com/api/v3

# ─── 依赖服务 ──────────────────────────────────────────────────────────────────
# RAG Service (Python FastAPI)
RAG_SERVICE_URL=http://localhost:8000

# Backend Server (Go API)
SERVER_URL=http://localhost:3000
INTERNAL_TOKEN=your-internal-service-token
# Optional: gRPC internal endpoint（预留，当前默认走 HTTP internal API）
SERVER_GRPC_URL=localhost:50051

# Optional: Redis (短期记忆，不配置则降级为内存）
REDIS_URL=redis://localhost:6379

# Optional: Manim 渲染服务
MANIM_SERVICE_URL=http://localhost:8002

# Optional: 对象存储上传服务
STORAGE_SERVICE_URL=http://localhost:8003

# ─── Node Governance (SLA / Timeout / Retry) ────────────────────────────────
# QA Node Policies
QA_NODE_OCR_TIMEOUT_MS=8000
QA_NODE_OCR_RETRY_MAX_ATTEMPTS=2
QA_NODE_OCR_RETRY_BACKOFF_MS=200
QA_NODE_RAG_TIMEOUT_MS=10000
QA_NODE_RAG_RETRY_MAX_ATTEMPTS=2
QA_NODE_RAG_RETRY_BACKOFF_MS=300
QA_NODE_GENERATE_TIMEOUT_MS=15000
QA_NODE_GENERATE_RETRY_MAX_ATTEMPTS=2
QA_NODE_GENERATE_RETRY_BACKOFF_MS=500

# Video Node Policies
VIDEO_NODE_CHECK_CACHE_TIMEOUT_MS=4000
VIDEO_NODE_GENERATE_STORYBOARD_TIMEOUT_MS=18000
VIDEO_NODE_GENERATE_SCRIPT_TIMEOUT_MS=30000
VIDEO_NODE_RENDER_MANIM_TIMEOUT_MS=60000
VIDEO_NODE_FIX_SCRIPT_TIMEOUT_MS=25000
VIDEO_NODE_UPLOAD_VIDEO_TIMEOUT_MS=15000
