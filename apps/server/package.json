{
  "name": "@tutor/server",
  "version": "0.0.1",
  "private": true,
  "description": "教育平台业务后端服务 (Go + Gin)",
  "scripts": {
    "dev": "air -c .air.toml",
    "start": "go run ./cmd/server",
    "start:grpc": "go run ./cmd/grpc",
    "build": "go build -o ./bin/server ./cmd/server",
    "build:grpc": "go build -o ./bin/grpc ./cmd/grpc",
    "test": "go test ./...",
    "fmt": "gofmt -w $(find ./cmd ./internal -name '*.go')",
    "proto:gen": "PATH=\"$(go env GOPATH)/bin:$PATH\" protoc --go_out=./api/gen --go_opt=paths=source_relative --go-grpc_out=./api/gen --go-grpc_opt=paths=source_relative --proto_path=./api/proto ./api/proto/task/v1/task.proto"
  }
}
