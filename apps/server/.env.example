# Server
PORT=3000
GRPC_PORT=50051
NODE_ENV=development
FRONTEND_URL=http://localhost:5173

# Database
# 目标态建议：postgres
# 迁移兼容：当前保留 DB_HOST/DB_PORT/DB_USERNAME/DB_PASSWORD/DB_NAME
# 以确保既有真实配置可直接沿用，不需要清空或重填。
DB_DRIVER=mysql
# 可选：优先级高于拆分字段，适用于云数据库直连
DB_DSN=
DB_HOST=localhost
DB_PORT=3306
DB_USERNAME=root
DB_PASSWORD=password
DB_NAME=tutor_db
# memory | sql
DB_REPOSITORY_MODE=memory

# Redis
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_USERNAME=
REDIS_PASSWORD=
# 新版可直接使用 REDIS_ADDR（优先级高于 REDIS_HOST/REDIS_PORT）
REDIS_ADDR=localhost:6379

# MQ / Workflow
KAFKA_BROKERS=localhost:9092

# JWT
JWT_SECRET=your-jwt-secret-key-change-in-production
JWT_EXPIRES_IN=7d
JWT_REFRESH_EXPIRES_IN=30d
INTERNAL_TOKEN=your-internal-service-token

# RAG Service
RAG_SERVICE_URL=http://localhost:8000

# Agent Service
AGENT_SERVICE_URL=http://localhost:8001

# AI Models
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
DEEPSEEK_API_KEY=
