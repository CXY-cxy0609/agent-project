# RAG Service
PORT=8000
DEBUG=true
LOG_LEVEL=INFO
TENANT_DEFAULT=public

# Vector Store (Qdrant)
QDRANT_URL=http://localhost:6333
QDRANT_API_KEY=
QDRANT_COLLECTION=tutor_knowledge
QDRANT_USER_MEMORY_COLLECTION=tutor_user_memory
QDRANT_VIDEO_CACHE_COLLECTION=tutor_video_cache

# Embedding Model (sentence-transformers)
EMBEDDING_MODEL=BAAI/bge-m3
EMBEDDING_DIMENSION=1024

# Reranker
RERANKER_MODEL=cross-encoder/ms-marco-MiniLM-L-6-v2
RERANKER_ENABLED=true

# Chunking
MAX_CHUNK_SIZE=512
CHUNK_OVERLAP=0.1
MIN_CHUNK_SIZE=50

# RAG Pipeline
TOP_K_RETRIEVE=20
TOP_K_RERANK=5
ENABLE_HYDE=true
RERANK_STRATEGY=adaptive
ADAPTIVE_RERANK_MIN_QUERY_LEN=12

# Redis Cache
REDIS_URL=redis://localhost:6379
EMBEDDING_CACHE_TTL=0
RAG_CACHE_TTL=300

# Security
INTERNAL_TOKEN=your-rag-internal-token
CORS_ALLOW_ORIGINS=http://localhost:5173
RATE_LIMIT_WINDOW_SECONDS=60
RATE_LIMIT_RETRIEVE_PER_WINDOW=120
RATE_LIMIT_WRITE_PER_WINDOW=30

# Retrieve governance
RETRIEVE_TIMEOUT_TOTAL_MS=2000
RETRIEVE_TIMEOUT_EMBEDDING_MS=450
RETRIEVE_TIMEOUT_SEARCH_MS=500
RETRIEVE_TIMEOUT_RERANK_MS=450
RETRIEVE_TIMEOUT_CONTEXT_MS=250
CIRCUIT_BREAKER_FAILURE_THRESHOLD=5
CIRCUIT_BREAKER_COOLDOWN_SECONDS=30

# Async index task
INDEX_TASK_WAIT_DEFAULT=false
INDEX_TASK_WAIT_TIMEOUT_SECONDS=30

# Idempotency and versioning
DEFAULT_DOC_VERSION=1
ENABLE_CHUNK_IDEMPOTENCY=true

# LLM (可选，用于 HyDE 查询扩展)
ANTHROPIC_API_KEY=

# tiktoken 编码文件缓存目录（解决网络受限环境下的下载问题）
# TIKTOKEN_CACHE_DIR=/path/to/tiktoken_cache
